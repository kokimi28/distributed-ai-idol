# ===== PiAPI (Flux + Kling) =====
KLING_API_KEY=your_piapi_api_key

# ===== Zep Cloud =====
ZEP_API_KEY=your_zep_api_key

# ===== Firebase =====
FIREBASE_PROJECT_ID=your-project-id
